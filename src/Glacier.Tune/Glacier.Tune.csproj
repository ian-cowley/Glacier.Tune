<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>Glacier.Tune</PackageId>
    <Version>1.0.7</Version>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Pure C# .NET 10 LLM fine-tuning, PEFT (LoRA / QLoRA), and model alignment engine. Direct GGUF zero-copy memory-mapping, zero-allocation Autograd backpropagation, and instant adapter fusion.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Tune</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Tune.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>llm;fine-tuning;lora;qlora;peft;gguf;qwen;deep-learning;csharp;net10;glacier</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.0.7: Full frozen base-weight transpose-GEMM backpropagation across all 7 projections in CUDA VRAM (Q4_K, Q6_K, Q8_0, Q4_0, F32) and AVX-512/AVX2 SIMD; warp-aligned arbitrary-head_dim Causal GQA training attention; exact 64-bit tiled online Cross-Entropy backpropagation; ChatML assistant header masking; microbatch gradient averaging; TargetModules selection; Native AOT reflection-free serialization; hardened GgufMerger with F32 &amp; PEFT layout support; 65 passing tests.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="Gpu\Kernels\tune_bwd.cubin" LogicalName="Glacier.Tune.Gpu.Kernels.tune_bwd.cubin" />
    <!-- Transitive security override for GHSA-2fmv-rv2c-59x7 & GHSA-846f-f764-76mx -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\..\Glacier.Inference\src\Glacier.Inference\Glacier.Inference.csproj') and '$(UseLocalProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\Glacier.Inference\src\Glacier.Inference\Glacier.Inference.csproj" Condition="Exists('..\..\..\Glacier.Inference\src\Glacier.Inference\Glacier.Inference.csproj') and '$(UseLocalProjectReferences)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\Glacier.Inference\src\Glacier.Inference\Glacier.Inference.csproj') or '$(UseLocalProjectReferences)' != 'true'">
    <PackageReference Include="Glacier.Inference" Version="1.3.0" Condition="!Exists('..\..\..\Glacier.Inference\src\Glacier.Inference\Glacier.Inference.csproj') or '$(UseLocalProjectReferences)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\..\Glacier.Tensor\src\Glacier.Tensor\Glacier.Tensor.csproj') and '$(UseLocalProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\Glacier.Tensor\src\Glacier.Tensor\Glacier.Tensor.csproj" Condition="Exists('..\..\..\Glacier.Tensor\src\Glacier.Tensor\Glacier.Tensor.csproj') and '$(UseLocalProjectReferences)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\Glacier.Tensor\src\Glacier.Tensor\Glacier.Tensor.csproj') or '$(UseLocalProjectReferences)' != 'true'">
    <PackageReference Include="Glacier.Tensor" Version="1.0.9" Condition="!Exists('..\..\..\Glacier.Tensor\src\Glacier.Tensor\Glacier.Tensor.csproj') or '$(UseLocalProjectReferences)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\..\Glacier.Gpu\src\Glacier.Gpu\Glacier.Gpu.csproj') and '$(UseLocalProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\Glacier.Gpu\src\Glacier.Gpu\Glacier.Gpu.csproj" Condition="Exists('..\..\..\Glacier.Gpu\src\Glacier.Gpu\Glacier.Gpu.csproj') and '$(UseLocalProjectReferences)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\Glacier.Gpu\src\Glacier.Gpu\Glacier.Gpu.csproj') or '$(UseLocalProjectReferences)' != 'true'">
    <PackageReference Include="Glacier.Gpu" Version="1.0.9" Condition="!Exists('..\..\..\Glacier.Gpu\src\Glacier.Gpu\Glacier.Gpu.csproj') or '$(UseLocalProjectReferences)' != 'true'" />
  </ItemGroup>
</Project>
